SNAKE_ENV=development
SNAKE_API_HOST=127.0.0.1
SNAKE_API_PORT=8000
SNAKE_ALLOWED_ORIGINS=http://localhost:3000
SNAKE_DATABASE_URL=sqlite:///./snake.db
SNAKE_JWT_SECRET_KEY=CHANGE_ME_FOR_LOCAL_DEVELOPMENT_ONLY
SNAKE_ACCESS_TOKEN_MINUTES=30
SNAKE_SCOPE_ALLOWLIST=example.com,*.staging.example.com
# Backend-only private key: signs worker tasks. Never mount this into a worker.
SNAKE_BACKEND_ED25519_PRIVATE_KEY_B64=
# Worker-specific public key: backend verifies that worker's acknowledgements.
SNAKE_WORKER_ED25519_PUBLIC_KEY_B64=
# Worker-only values: backend public key verifies tasks; worker private key signs acknowledgements.
SNAKE_BACKEND_ED25519_PUBLIC_KEY_B64=
SNAKE_WORKER_ED25519_PRIVATE_KEY_B64=
SNAKE_WORKER_ID=local-validator
SNAKE_WORKER_KEY_ID=local-validator-v1
