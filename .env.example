SNAKE_ENV=development
SNAKE_API_HOST=127.0.0.1
SNAKE_API_PORT=8000
SNAKE_ALLOWED_ORIGINS=http://localhost:3000
SNAKE_DATABASE_URL=sqlite:///./snake.db
# Replace with a long random secret before use outside local development.
SNAKE_JWT_SECRET_KEY=CHANGE_ME_FOR_LOCAL_DEVELOPMENT_ONLY
SNAKE_ACCESS_TOKEN_MINUTES=30
# Only list domains you are explicitly authorized to test.
SNAKE_SCOPE_ALLOWLIST=example.com,*.staging.example.com
# Dedicated secret for the isolated worker validator (32+ random characters).
# Do not reuse SNAKE_JWT_SECRET_KEY. Required only when running the worker profile.
SNAKE_WORKER_SIGNING_SECRET=
SNAKE_WORKER_ID=local-validator
