# Backend
SNAKE_ENV=development
SNAKE_API_HOST=127.0.0.1
SNAKE_API_PORT=8000
SNAKE_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated authorized hostnames for local development only.
# Never add targets unless you have explicit permission to test them.
SNAKE_SCOPE_ALLOWLIST=example.com,*.staging.example.com
